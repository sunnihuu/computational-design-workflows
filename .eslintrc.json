{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "d3": "readonly",
    "mapboxgl": "readonly",
    "THREE": "readonly",
    "firebase": "readonly",
    "p5": "readonly",
    "createCanvas": "readonly",
    "windowWidth": "readonly",
    "windowHeight": "readonly",
    "noStroke": "readonly",
    "windowResized": "readonly",
    "clear": "readonly",
    "map": "readonly",
    "mouseX": "readonly",
    "mouseY": "readonly",
    "width": "readonly",
    "height": "readonly",
    "noise": "readonly",
    "fill": "readonly",
    "circle": "readonly",
    "setup": "readonly",
    "draw": "readonly",
    "Hands": "readonly",
    "CanvasUtils": "readonly"
  },
  "rules": {
    "no-console": "off",
    "no-inner-declarations": "off",
    "no-unused-vars": ["warn", { "vars": "local", "args": "none", "ignoreRestSiblings": true }]
  }

  ,"overrides": [
    {
      "files": ["server/**"],
      "env": { "node": true },
      "globals": { "process": "readonly", "require": "readonly", "module": "readonly" }
    }
  ]
}
